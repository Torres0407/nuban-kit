{
  "name": "nuban-kit",
  "version": "0.1.1",
  "description": "Nigerian bank account (NUBAN) validation and account-name resolution toolkit.",
  "keywords": [
    "nuban",
    "nigeria",
    "bank",
    "account",
    "verification",
    "paystack",
    "account-name",
    "nip"
  ],
  "license": "MIT",
  "author": "Torres0407 (https://github.com/Torres0407)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Torres0407/nuban-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Torres0407/nuban-kit/issues"
  },
  "homepage": "https://github.com/Torres0407/nuban-kit#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "publint": "^0.3.25",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "fflate": "0.8.2"
  }
}
